{
  "schema_version": "asdi.run-contract/v1",
  "task_type": "feature",
  "objective": "Reject shell metacharacters",
  "why": "A semicolon can turn one verified command into several commands.",
  "constraints": [],
  "out_of_scope": [],
  "done_check": {
    "description": "This command attempts to append another command.",
    "argv": ["python3", "-m", "unittest", "discover; echo compromised"]
  },
  "boundaries": {
    "protected_paths": ["CODEOWNERS"],
    "max_changed_lines": 400,
    "network": {"mode": "deny_all"},
    "production_access": false,
    "irreversible_actions": false
  },
  "guardrails": {
    "max_turns": 200,
    "max_spend_usd": 8,
    "wall_clock_seconds": 5400
  },
  "output": {"kind": "report"},
  "provenance": {
    "human_provided": ["objective", "why"],
    "lead_agent_authored": ["constraints", "out_of_scope", "done_check"],
    "platform_defaults": ["boundaries", "guardrails", "output", "task_type"]
  }
}
