{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdi.local/schemas/product.schema.json",
  "title": "ASDI product profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "run_image", "services", "task_types", "architecture_baseline"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "run_image": { "type": "string", "minLength": 1 },
    "services": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "task_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$" } },
    "architecture_baseline": { "type": "string", "minLength": 1 }
  }
}
