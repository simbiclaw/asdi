{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdi.local/schemas/statement.schema.json",
  "title": "Unsigned ASDI in-toto verification statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string" },
          "digest": {
            "type": "object",
            "required": ["gitCommit"],
            "properties": { "gitCommit": { "type": "string" } },
            "additionalProperties": false
          }
        }
      }
    },
    "predicateType": { "const": "https://asdi.local/verification/v1" },
    "predicate": { "type": "object" }
  }
}
