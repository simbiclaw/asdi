{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdi.local/schemas/run-contract.schema.json",
  "title": "ASDI REV K run contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_type",
    "product",
    "objective",
    "why",
    "constraints",
    "out_of_scope",
    "done_check",
    "services",
    "verify",
    "evidence",
    "resume",
    "guardrails"
  ],
  "properties": {
    "contract_version": { "const": 3 },
    "task_type": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$" },
    "product": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "why": { "type": "string", "minLength": 1 },
    "constraints": { "$ref": "#/$defs/stringArray" },
    "out_of_scope": { "$ref": "#/$defs/stringArray" },
    "done_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "$ref": "#/$defs/argv" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "experiment": { "type": "string" },
    "services": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "features": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "changed": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": { "required": { "type": "boolean" } }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": { "from": { "type": ["string", "null"] } }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "minutes"],
      "properties": {
        "turns": { "type": "integer", "minimum": 1 },
        "spend_usd": { "type": ["number", "null"], "minimum": 0 },
        "minutes": { "type": "integer", "minimum": 1 },
        "tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
