{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdi.local/schemas/seed.schema.json",
  "title": "ASDI seeded defect",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "patch", "layer", "expect_caught_by", "unit_tests_stay_green"],
  "properties": {
    "id": { "type": "string" },
    "patch": { "type": "string" },
    "layer": { "type": "integer", "minimum": 1, "maximum": 5 },
    "expect_caught_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(static|verify|review:[a-z0-9-]+|policy)$" }
    },
    "unit_tests_stay_green": { "type": "boolean" }
  }
}
