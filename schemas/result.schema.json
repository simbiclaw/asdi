{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdi.local/schemas/result.schema.json",
  "title": "ASDI verifier result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "commit", "features"],
  "properties": {
    "schema": { "const": 2 },
    "run_id": { "type": "string", "pattern": "^r-[A-Za-z0-9-]+$" },
    "commit": { "type": "string", "minLength": 1 },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "control", "evidence", "limits"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["pass", "fail", "blocked", "error", "not_applicable"] },
          "control": { "enum": ["caught", "missed", "not_applicable"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "limits": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
