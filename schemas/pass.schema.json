{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdi.local/schemas/pass.schema.json",
  "title": "ASDI review pass output (Build Guide V4 REV K section 10.2, N-6)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pass", "model", "independent_family", "reviewed_commit", "status", "findings"],
  "properties": {
    "schema": { "const": 2 },
    "pass": { "enum": ["review", "contract", "correctness", "security", "blast-radius"] },
    "model": { "type": "string", "minLength": 1 },
    "independent_family": { "enum": ["true", "false", "unavailable"] },
    "reviewed_commit": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail", "blocked"] },
    "blocked_reason": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "bucket", "strike", "claim"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]+$" },
          "bucket": { "enum": ["act", "consider", "noted", "dismissed"] },
          "strike": { "type": "boolean" },
          "concern": { "enum": ["contract", "correctness", "security"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
