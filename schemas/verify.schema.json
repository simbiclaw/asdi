{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdi.local/schemas/verify.schema.json",
  "title": "ASDI verify manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product", "services", "drive_kinds", "self_test"],
  "properties": {
    "schema": { "const": 2 },
    "product": { "type": "string", "minLength": 1 },
    "services": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "drive_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["cli", "http", "ui", "job", "webhook", "property"] }
    },
    "self_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature"],
      "properties": { "feature": { "type": "string", "minLength": 1 } }
    }
  }
}
