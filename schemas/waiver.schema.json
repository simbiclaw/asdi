{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdi.local/schemas/waiver.schema.json",
  "title": "ASDI gate waiver",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "waivers"],
  "properties": {
    "version": { "const": 1 },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gate", "scope", "reason", "expires"],
        "properties": {
          "id": { "type": "string" },
          "gate": { "type": "string" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" },
          "expires": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
